# Copie este archivo como .env.local (desarrollo) o configure las variables en Vercel.
# NUNCA ponga aquí la llave service_role de Supabase: la API trabaja con el token de cada usuario (RLS).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Correos (invitaciones). Sin esta llave, el endpoint de invitaciones responde 503.
RESEND_API_KEY=
CORREO_REMITENTE="Contafi <no-responder@contafi.co>"

# URL pública del sitio, para los enlaces de los correos.
URL_SITIO=https://contafi.co

# Sitio público (páginas Soporte y Descargar). Sin valor, la página lo dice en lugar de inventarlo.
NEXT_PUBLIC_SOPORTE_CORREO=
# Solo dígitos, con indicativo del país (ej.: 573001234567)
NEXT_PUBLIC_SOPORTE_WHATSAPP=
# Ej.: "Lunes a viernes, 8:00 a. m. a 6:00 p. m. (hora de Colombia)"
NEXT_PUBLIC_SOPORTE_HORARIO=
# Enlace al instalador de Windows (cuando se publique)
NEXT_PUBLIC_URL_DESCARGA=
